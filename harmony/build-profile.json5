{
  "app": {
    // 签名：在 DevEco Studio → Project Structure → Signing Configs 里勾选
    // 「Automatically generate signature」后，这里会自动写入 signingConfigs，
    // 并把下面 products[0].signingConfig 指过去。不要手抄别人的证书。
    "signingConfigs": [],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // compatibleSdkVersion 是「最低兼容 SDK」：6.0.0(20) 覆盖鸿蒙 6/7 真机
        // （7 向下兼容 6 的 API；本工程只用 API 12 级能力）。若本机 DevEco
        // 对该值报过旧告警，按提示升到本机 SDK 对应版本即可。
        "compatibleSdkVersion": "6.0.0(20)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {}
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        { "name": "default", "applyToProducts": ["default"] }
      ]
    }
  ]
}
